{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "server/migrations/**"
    }
  },
  "rewrites": [
    {
      "source": "/impressum",
      "destination": "/client.html"
    },
    {
      "source": "/impressum/",
      "destination": "/client.html"
    },
    {
      "source": "/datenschutz",
      "destination": "/client.html"
    },
    {
      "source": "/datenschutz/",
      "destination": "/client.html"
    },
    {
      "source": "/danke",
      "destination": "/client.html"
    },
    {
      "source": "/danke/",
      "destination": "/client.html"
    }
  ],
  "crons": [
    {
      "path": "/api/inquiries/retry",
      "schedule": "0 3 * * *"
    }
  ]
}
