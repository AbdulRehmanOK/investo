# Local/persistent Node server defaults. Vercel settings are documented in integration/VERCEL.md.
PORT=3001
HOST=127.0.0.1
PUBLIC_SITE_URL=http://127.0.0.1:3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001
LEAD_DB_PATH=.data/submissions.sqlite
# Vercel only: use an HTTPS PUBLIC_SITE_URL and exact HTTPS ALLOWED_ORIGINS.
# Example PUBLIC_SITE_URL=https://investo-blush.vercel.app
# Server-only managed PostgreSQL URL; verified TLS is enforced.
# DATABASE_URL takes precedence over the optional POSTGRES_URL alias.
DATABASE_URL=
POSTGRES_URL=
# Server-only secret. Never VITE_ variables, browser code, URLs or source control.
PROPSTACK_API_KEY=
# Confirmed shared intake owner: 443334 (info@investo-immobilien.de).
# Existing Alpaslan/Akay ownership is preserved; no round robin.
# Blank disables the Vercel form; the persistent Node server sends new contacts to review.
# Existing eligible owners are always preserved.
PROPSTACK_NEW_CONTACT_OWNER_ID=443334
# Set true only after approving exact DE/EN/FR wording in shared/lead-schema.mjs.
CONTACT_CONSENT_APPROVED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Vercel retry-worker Bearer secret: at least 32 random characters; never put in a URL.
CRON_SECRET=
# Set true only after verifying a frequent authenticated GET /api/inquiries/retry schedule.
# The bundled daily Vercel cron is a backup, not sufficient on its own.
INQUIRY_RETRY_SCHEDULE_CONFIRMED=false
# Optional exact trusted proxy IPs/CIDRs, never arbitrary forwarded headers.
TRUST_PROXY=
# No n8n URL: Propstack sends the signed event to the existing callback worker.
